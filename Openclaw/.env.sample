# ===== OpenClaw .env (copy to .env and fill in) =====
# .env is git-ignored. Never commit real keys.

# Base image used to build the custom OpenClaw image
OPENCLAW_BASE_IMAGE=ghcr.io/openclaw/openclaw:latest

# Custom local image (Dockerfile + startup bootstrap script)
OPENCLAW_IMAGE=openclaw-custom:latest

# Docker named volume used for all persistent OpenClaw data under /home/node
# (config, sessions, workspace, Claude CLI install/auth).
OPENCLAW_HOME_VOLUME_NAME=openclaw_home

# Gateway auth token (REQUIRED when binding to LAN). Generate with:
#   openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=replace-with-generated-token

# Host ports
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_BRIDGE_PORT=18790

# Stateful Chrome sidecar (localhost-only). CDP is used by OpenClaw and by you.
# Profile (cookies/logins) persists in the chrome-profile named volume.
CHROME_CDP_PORT=9222
CHROME_NOVNC_PORT=6080
CHROME_PROFILE_VOLUME_NAME=openclaw_chrome_profile
# Optional override if OpenClaw should attach to a different CDP endpoint
# OPENCLAW_CHROME_CDP_URL=http://chrome:9222

# lan = reachable from other machines on your network; loopback = this PC only
OPENCLAW_GATEWAY_BIND=lan

# Gateway mode bootstrap (required by current OpenClaw startup checks)
OPENCLAW_GATEWAY_MODE=local

# Timezone for logs and scheduled jobs
OPENCLAW_TZ=UTC

# ----- Container startup bootstrap -----
# Set to 0 to skip Telegram channel bootstrap at startup.
OPENCLAW_BOOTSTRAP_TELEGRAM=1

# REQUIRED Anthropic setup-token for non-interactive subscription auth.
# Get one from a logged-in Claude CLI host:
#   claude setup-token
ANTHROPIC_SETUP_TOKEN=

# Applied automatically at startup.
OPENCLAW_DEFAULT_MODEL=anthropic/claude-sonnet-5-5

# ----- Claude Pro/Max subscription (Anthropic via Claude CLI) -----
# Startup auto-installs Claude CLI in the container if missing.
# Container startup will fail if ANTHROPIC_SETUP_TOKEN is empty or missing.
# Leave ANTHROPIC_API_KEY unset when using setup-token subscription auth.
# ANTHROPIC_API_KEY=

# ----- Other provider keys (optional) -----
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# ----- Channel tokens (optional) -----
# TELEGRAM_BOT_TOKEN=
# DISCORD_BOT_TOKEN=
# SLACK_BOT_TOKEN=

# ----- Tools (optional) -----
# BRAVE_API_KEY=
